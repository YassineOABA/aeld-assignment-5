#!/bin/sh
# /etc/init.d/S98lddmodules

case "$1" in
    start)
        echo "Loading LDD modules..."
        /usr/bin/scull_load
        /usr/bin/module_load faulty
        modprobe hello
        ;;
    stop)
        echo "Unloading LDD modules..."
        /usr/bin/scull_unload
        /usr/bin/module_unload faulty
        modprobe -r hello
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
